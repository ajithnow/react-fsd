    "react-redux": "^9.2.0",
    "react-top-loading-bar": "^3.0.2",
    "react-window": "^1.8.11",
    "redux-persist": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-environment": "^1.1.3",
    "zod": "^4.0.5"
