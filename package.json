    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^12.3.2",
    "node-fetch": "^2.6.7",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "3.6.2",
    "tw-animate-css": "^1.3.5",
    "typescript": "^7.0.2",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxlint --type-aware --fix",
      "vitest related --run"
    ],
    "vite.config.ts": "oxlint --type-aware --fix",
    "**/*.{js,css,md,json}": "prettier --write"
